# Expo automatically loads EXPO_PUBLIC_ variables and embeds them in the client.
# Never put private server secrets in this file.
EXPO_PUBLIC_KAKAO_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_REDIRECT_URI=fridiet://login-callback
EXPO_PUBLIC_BASE_URL=http://localhost:8080
EXPO_PUBLIC_AI_BASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPPORT_EMAIL=fridiet.official@gmail.com
EXPO_PUBLIC_ENABLE_ACCOUNT_RECOVERY=true
# Confirm this path with the deployed backend's profile API.
EXPO_PUBLIC_PROFILE_ENDPOINT=/api/users/me
